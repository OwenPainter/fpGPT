# -------------------------------------------------------------------------- #
# Quartus Prime Settings File
# fpGPT - DE1-SoC (Cyclone V 5CSEMA5F31C6)
#
# Build with:  quartus_sh -t build.tcl      (from fpga/)
# or open fpGPT.qpf in the GUI.
#
# Board parameters and the ROM image are produced by the compiler and copied
# into this directory by build.tcl:
#   ../build/rtl/board_params.vh  -> board_params.vh
#   ../build/weights/engine/weights_unified.hex -> weights_unified.hex
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name DEVICE_FILTER_PACKAGE FBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 896
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 6
set_global_assignment -name TOP_LEVEL_ENTITY fpga_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name BOARD "DE1-SoC Board"

# -------------------------------------------------------------------------- #
# Source files
# -------------------------------------------------------------------------- #

set_global_assignment -name VERILOG_FILE fpga_top.v
set_global_assignment -name VERILOG_FILE pll_150.v
set_global_assignment -name VERILOG_FILE uart_rx.v
set_global_assignment -name VERILOG_FILE uart_tx.v
set_global_assignment -name VERILOG_FILE generation_controller.v

set_global_assignment -name VERILOG_FILE ../hdl/transformer_engine.v
set_global_assignment -name VERILOG_FILE ../hdl/attention.v
set_global_assignment -name VERILOG_FILE ../hdl/layer_norm.v
set_global_assignment -name VERILOG_FILE ../hdl/dense_layer.v
set_global_assignment -name VERILOG_FILE ../hdl/mac_unit.v
set_global_assignment -name VERILOG_FILE ../hdl/activation.v
set_global_assignment -name VERILOG_FILE ../hdl/rom_sync.v

# Compiler-generated board parameters (include path for `include "board_params.vh")
set_global_assignment -name VERILOG_INCLUDE_FILE board_params.vh

# -------------------------------------------------------------------------- #
# Clocking: instantiate pll_150 (50 MHz -> 150 MHz). Undefine for a 50 MHz build.
# -------------------------------------------------------------------------- #
set_global_assignment -name VERILOG_MACRO "FPGPT_USE_PLL=1"

# -------------------------------------------------------------------------- #
# Weight ROM initialization
#
# rom_sync uses $readmemh(ROM_MEM_FILE). build.tcl copies the compiled
# uniform-width engine image to weights_unified.hex next to the project, and
# SEARCH_PATH covers the compiler output directory as a fallback. MIF_FILE
# registers the image with the project as a memory-init file.
# -------------------------------------------------------------------------- #
set_global_assignment -name SEARCH_PATH ../build/weights/engine
set_global_assignment -name MIF_FILE weights_unified.hex

# -------------------------------------------------------------------------- #
# Pin assignments (DE1-SoC)
# -------------------------------------------------------------------------- #

# Clock (50 MHz oscillator)
set_location_assignment PIN_AF14 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50

# Reset key (KEY[0]); the other keys are unused
set_location_assignment PIN_AA14 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]

# UART on the GPIO_0 expansion header (external 3.3 V USB-TTL adapter).
#   GPIO_0[0] = PIN_AC18  -> adapter TX  (FPGA RX)
#   GPIO_0[1] = PIN_Y17   -> adapter RX  (FPGA TX)
# There is no direct FPGA-to-USB UART on the DE1-SoC; the onboard USB-UART is
# wired to the HPS. See PROGRAMMING.md for wiring.
set_location_assignment PIN_AC18 -to UART_RXD
set_location_assignment PIN_Y17  -to UART_TXD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_RXD
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to UART_TXD

# Debug LEDs
set_location_assignment PIN_V16 -to LEDR[0]
set_location_assignment PIN_W16 -to LEDR[1]
set_location_assignment PIN_V17 -to LEDR[2]
set_location_assignment PIN_V18 -to LEDR[3]
set_location_assignment PIN_W17 -to LEDR[4]
set_location_assignment PIN_W19 -to LEDR[5]
set_location_assignment PIN_Y19 -to LEDR[6]
set_location_assignment PIN_W20 -to LEDR[7]
set_location_assignment PIN_W21 -to LEDR[8]
set_location_assignment PIN_Y21 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]

# -------------------------------------------------------------------------- #
# Timing constraints
# -------------------------------------------------------------------------- #
set_global_assignment -name SDC_FILE fpGPT.sdc

# -------------------------------------------------------------------------- #
# Fitter / analysis options
# -------------------------------------------------------------------------- #
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name ENABLE_SIGNALTAP OFF
